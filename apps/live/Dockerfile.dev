FROM node:22-alpine

RUN apk add --no-cache libc6-compat
# See Dockerfile.live: Playwright's own Chromium download doesn't run on Alpine's
# musl libc, so whiteboard PDF-export rendering uses Alpine's own chromium apk package.
RUN apk add --no-cache chromium nss freetype harfbuzz ca-certificates ttf-freefont
ENV CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser
WORKDIR /app

COPY . .
RUN corepack enable pnpm && pnpm add -g turbo
RUN pnpm install
EXPOSE 3003

ENV TURBO_TELEMETRY_DISABLED=1

VOLUME [ "/app/node_modules", "/app/live/node_modules"]

CMD ["pnpm","dev", "--filter=live"]
