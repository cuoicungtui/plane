PORT=3100
API_BASE_URL="http://localhost:8000"

WEB_BASE_URL="http://localhost:3000"

# System Chromium binary used to headlessly render whiteboard embeds for PDF export.
# Only needed if the runtime image installs Chromium at a different path.
# CHROMIUM_EXECUTABLE_PATH="/usr/bin/chromium-browser"

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="secret-key"

# If you prefer not to provide a Redis URL, you can set the REDIS_HOST and REDIS_PORT environment variables instead.
REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_URL="redis://localhost:6379/"
